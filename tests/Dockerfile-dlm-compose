ARG PYTHON_VERSION=3.12

FROM golang:1.26-bookworm AS librclone
ARG RCLONE_VERSION=1.75.1
RUN go mod download github.com/rclone/rclone@v${RCLONE_VERSION} \
    && cd /go/pkg/mod/github.com/rclone/rclone@v${RCLONE_VERSION} \
    && go build --buildmode=c-shared -o /usr/local/lib/librclone.so ./librclone

FROM python:${PYTHON_VERSION} AS buildenv
ARG POETRY_VERSION=2.5.1
RUN pip install poetry==${POETRY_VERSION}

WORKDIR /app

# Cache main dependencies
COPY pyproject.toml poetry.lock ./
RUN poetry config virtualenvs.in-project true \
    && poetry install --only main --no-root

COPY ./ ./
RUN . .venv/bin/activate \
    && pip install --no-deps .

FROM python:${PYTHON_VERSION}-slim AS dlm_runtime

RUN apt-get update && apt-get install -y rclone

# Best practice not to run as root
RUN useradd --uid 1000 --user-group --create-home ska-dlm
COPY --from=librclone /usr/local/lib/librclone.so /usr/local/lib/librclone.so
ENV DLM_RCLONE_LIBRARY_PATH=/usr/local/lib/librclone.so
ENV HOME=/home/ska-dlm
USER ska-dlm

# Copy all Python packages & console scripts to the runtime container
COPY --from=buildenv /app/.venv /app/.venv/
ENV PATH="/app/.venv/bin:${PATH}"

COPY ./tests/volumes/config-dockercompose.yaml /home/ska-dlm/.dlm/config.yaml
COPY ./tests/storage-config.json /home/ska-dlm/.dlm/storage-config.json
COPY ./tests/location-config.json /home/ska-dlm/.dlm/location-config.json
