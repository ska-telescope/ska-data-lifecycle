FROM alpine:3.22

ARG KUBECTL_VERSION=v1.35.5
ARG TARGETARCH

RUN apk add --no-cache ca-certificates curl openssh-client openssh-keygen \
    && case "${TARGETARCH:-$(uname -m)}" in \
      amd64|x86_64) arch=amd64 ;; \
      arm64|aarch64) arch=arm64 ;; \
      *) echo "Unsupported kubectl architecture: ${TARGETARCH:-$(uname -m)}" >&2; exit 1 ;; \
    esac \
    && curl --fail --location --silent --show-error \
      "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${arch}/kubectl" \
      --output /usr/local/bin/kubectl \
    && chmod 0755 /usr/local/bin/kubectl \
    && apk del curl

COPY tests/ensure-rclone-ssh-key.sh /usr/local/bin/ensure-rclone-ssh-key
RUN chmod 0755 /usr/local/bin/ensure-rclone-ssh-key
